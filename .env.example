# Copy to .env (git-ignored) and fill in only the keys you use. Never commit real values.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
TYPESAFE_API_KEY=
# Dashboard database (Neon Postgres). Owner URL is used only locally to load data;
# the deployed API uses a read-only role URL set in the Vercel project settings.
DATABASE_URL=
DATABASE_URL_READONLY=
