    {
      "review_id": "75436e8f-c714-4a55-b705-a5a0c7e11130",
      "fields": [
        "topic",
        "severity"
      ],
      "text": "I loved it at first cuz I was able to play whatever I wanted and skip songs and didn't have to deal with ads. Then something happened after about two weeks and I was instantly getting bombarded with ads end I was no longer able to skip songs or play what I wanted. I'm going back to using Pandora. At least I can pay for Pandora plus through Google play. FU Spotify",
      "enricher": {
        "issue": "billing.premium_only",
        "intent": "cancellation",
        "severity": 3,
        "labeled_by": "primary"
      },
      "verifier": {
